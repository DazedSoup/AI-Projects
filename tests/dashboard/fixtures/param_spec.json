{"version": 1, "groups": [
  {"id": "network", "label": "Network", "params": [
    {"key": "n_nodes", "label": "Hosts", "type": "int", "default": null, "min": 10, "max": 20, "step": 1,
     "nullable": true, "help": "null = seeded 12-16", "target": "cli", "flag": "--n-nodes"},
    {"key": "max_rounds", "label": "Turn limit", "type": "int", "default": 36, "min": 10, "max": 80, "step": 1,
     "help": "rounds before blue wins on time", "target": "env"}
  ]},
  {"id": "red", "label": "Red", "params": [
    {"key": "p_phish", "label": "Phish success", "type": "float", "default": 0.35, "min": 0.0, "max": 1.0,
     "step": 0.01, "help": "chance a phish lands a foothold", "target": "env"},
    {"key": "p_exploit", "label": "Exploit success", "type": "float", "default": 0.45, "min": 0.0, "max": 1.0,
     "step": 0.01, "help": "chance an exploit works", "target": "env"},
    {"key": "noise.phish", "label": "Phish noise", "type": "float", "default": 0.85, "min": 0.0, "max": 1.0,
     "step": 0.05, "help": "how visible a phish is to the detectors", "target": "env"},
    {"key": "p_implant_leak.malware", "label": "Implant leak (malware)", "type": "float", "default": 0.2,
     "min": 0.0, "max": 1.0, "step": 0.01, "help": "...", "target": "env", "advanced": true}
  ]},
  {"id": "blue", "label": "Blue", "params": [
    {"key": "detect_threshold", "label": "Detection threshold", "type": "float", "default": 0.5, "min": 0.05,
     "max": 0.95, "step": 0.05, "help": "score above which a host is flagged", "target": "env"}
  ]},
  {"id": "opponents", "label": "Opponents", "params": [
    {"key": "baseline", "label": "Baseline type", "type": "choice", "default": "heuristic",
     "choices": ["heuristic", "random"], "target": "cli", "flag": "--baseline"}
  ]},
  {"id": "training", "label": "Training", "params": [
    {"key": "episodes", "label": "Episodes", "type": "int", "default": 2000, "min": 100, "max": 10000, "step": 100,
     "help": "training episodes", "target": "cli", "flag": "--episodes"},
    {"key": "eval_every", "label": "Eval every", "type": "int", "default": 250, "min": 50, "max": 1000, "step": 50,
     "help": "episodes between evals", "target": "cli", "flag": "--eval-every"},
    {"key": "seed", "label": "Seed", "type": "int", "default": 7, "target": "cli", "flag": "--seed",
     "help": "RNG seed", "advanced": true},
    {"key": "no_turn_log", "label": "Skip turn log", "type": "bool", "default": false, "target": "cli",
     "flag": "--no-turn-log", "help": "no episodes.jsonl", "advanced": true}
  ]},
  {"id": "memory", "label": "Memory", "params": [
    {"key": "init_side", "label": "Warm-start side", "type": "choice", "default": "both",
     "choices": ["both", "red", "blue"], "target": "cli", "flag": "--init-side",
     "help": "which learners load the parent run's Q-tables"}
  ]}
]}
